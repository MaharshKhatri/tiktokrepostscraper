# Copy to .env and adjust. Every setting in config/settings.py can be set here
# with the AUDIT_ prefix; nested groups use a double underscore.

# --- Claude API -------------------------------------------------------------
# The SDK reads ANTHROPIC_API_KEY (or an `ant auth login` profile) on its own.
ANTHROPIC_API_KEY=
# Map stage (per-batch vision analysis) and reduce stage (digests + sections).
AUDIT_ANTHROPIC__VISION_MODEL=claude-sonnet-5-5
AUDIT_ANTHROPIC__SYNTHESIS_MODEL=claude-sonnet-5-5
AUDIT_ANTHROPIC__VISION_EFFORT=medium
AUDIT_ANTHROPIC__SYNTHESIS_EFFORT=high
AUDIT_ANTHROPIC__VISION_ITEMS_PER_BATCH=8
AUDIT_ANTHROPIC__CONCURRENCY=3
# Server-side refusal fallbacks (fallbacks="default"); set false to disable.
AUDIT_ANTHROPIC__REFUSAL_FALLBACKS=true

# --- Browser ----------------------------------------------------------------
AUDIT_BROWSER__HEADLESS=true
# Point at a specific Chromium if Playwright's bundled build is not installed.
# AUDIT_BROWSER__EXECUTABLE_PATH=/path/to/chrome
AUDIT_BROWSER__LOCALE=en-US
AUDIT_BROWSER__TIMEZONE_ID=America/New_York

# --- Collection & pacing ----------------------------------------------------
# 0 = collect every item on each surface.
AUDIT_SCRAPE__MAX_ITEMS_PER_SURFACE=0
AUDIT_SCRAPE__IG_COMMENTS_PER_POST=25
AUDIT_RATE_LIMITS__REQUEST_DELAY_MIN_S=1.2
AUDIT_RATE_LIMITS__REQUEST_DELAY_MAX_S=3.5
AUDIT_RATE_LIMITS__DOWNLOAD_CONCURRENCY=3

# --- Local media processing -------------------------------------------------
AUDIT_MEDIA__KEYFRAMES_MIN=4
AUDIT_MEDIA__KEYFRAMES_MAX=6
AUDIT_MEDIA__CONTACT_SHEET_MAX_EDGE=2400
AUDIT_WHISPER__MODEL_SIZE=small
AUDIT_WHISPER__DEVICE=auto
# AUDIT_WHISPER__LANGUAGE=en

# --- Paths (relative to the project root) ------------------------------------
# AUDIT_DATA_DIR=data
# AUDIT_REPORTS_DIR=reports
# AUDIT_SESSIONS_DIR=auth/sessions
